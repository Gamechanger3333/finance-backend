# Copy this file to .env and fill in real values before running the server.
# Never commit the actual .env file.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/finflow"

# Secret used to sign JWTs — the server refuses to start without this.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=""

# Groq API key for AI features (chat, insights, monthly reports).
# Without it, AI endpoints fall back to canned responses instead of erroring.
GROQ_API_KEY=""

# Optional — which Groq model to use. Defaults to openai/gpt-oss-120b if
# unset. Only change this if Groq deprecates the current model again
# (check https://console.groq.com/docs/deprecations).
GROQ_MODEL="openai/gpt-oss-120b"

# Resend API key + from-address for transactional email (verification, OTP).
RESEND_API_KEY=""
EMAIL_FROM="FinFlow <noreply@yourdomain.com>"

# Frontend origin allowed by CORS (must match exactly, no trailing slash).
FRONTEND_URL="http://localhost:3000"

# Optional
PORT=3001
NODE_ENV="development"
LOG_LEVEL="info"
# Cron schedule for the daily recurring-bill auto-pay + notification sweep.
# Default: 6 AM server time every day.
RECURRING_AUTO_PAY_CRON="0 6 * * *"
