# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it's already in .gitignore.

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/finflow"

# Secret used to sign JWT session tokens — must be a long, random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app refuses to start without this set.
SESSION_SECRET=""

# Origin of the frontend app — used for CORS. Must match exactly (scheme + host + port).
FRONTEND_URL="http://localhost:3000"

# Port the Express server listens on
PORT=3001

# Groq API key for the AI assistant (chat + insights). Get one at https://console.groq.com
GROQ_API_KEY=""

# Resend API key for transactional email (verification, password reset)
RESEND_API_KEY=""
EMAIL_FROM="FinFlow <onboarding@resend.dev>"

# "development" | "production" — controls verbose logging and error detail.
# Most hosting platforms (Render/Railway/Heroku) set this automatically.
NODE_ENV="development"

# pino log level: "trace" | "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"
